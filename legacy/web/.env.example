# API prefix. Development example: http://localhost:7001/
# Production example: /torzo-gallery-server/
VITE_API_PREFIX=http://localhost:7001/

# Optional image cache worker. Leave empty to disable.
VITE_CACHE_WORKER_URL=

# Shown at the top of the public site.
VITE_BUILD_DESCRIPTION=

# Site base path. Must start and end with "/".
# Use "/" for https://example.com/admin, or "/torzo-gallery/" for
# https://example.com/torzo-gallery/admin.
VITE_BASE_PATH=/
