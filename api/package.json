{
  "name": "@torzo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "APP_ENV=development node --watch --watch-preserve-output --import tsx --env-file-if-exists=.env.development src/index.ts",
    "start": "APP_ENV=production node --env-file-if-exists=.env.production dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src test"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=10.24.0"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "immutable": "^5.1.9",
    "sharp": "^0.35.5",
    "vait": "^4.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.89.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
