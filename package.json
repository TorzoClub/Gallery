{
  "name": "torzo-gallery",
  "title": "Torzo Gallery",
  "version": "4.0.0-preview",
  "private": true,
  "type": "module",
  "description": "Torzo Gallery monolithic SPA + dispatch API",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "APP_ENV=development tsx watch --exclude 'node_modules/**' --exclude './storage/**' --exclude './storage-dev/**' --exclude 'dist/**' --exclude 'legacy/**' --exclude '.git/**' --env-file=.env.development src/server/index.ts",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build && tsx src/server/cli/precompress.ts",
    "build:server": "tsup",
    "analyze": "ANALYZE=true vite build",
    "start": "pnpm build && APP_ENV=production node --env-file-if-exists=.env.production dist/server/index.js",
    "start:prod": "APP_ENV=production node --env-file-if-exists=.env.production dist/server/index.js",
    "storage:init": "tsx src/server/cli/init-storage.ts",
    "migration:legacy": "tsx src/server/cli/migration-legacy.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "oxlint src test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=10.24.0"
  },
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@juggle/resize-observer": "^3.4.0",
    "@tabler/icons-react": "^3.50.0",
    "axios": "^1.20.0",
    "busboy": "^1.6.0",
    "clsx": "^2.1.1",
    "heic-convert": "^2.1.0",
    "hono": "^4.13.13",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "immutable": "^5.1.9",
    "motion": "^14.7.1",
    "ramda": "^0.29.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-images-uploading": "^3.1.7",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "swr": "^2.3.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "uuid": "^14.0.3",
    "vait": "^4.2.1",
    "zod": "^4.6.7",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/busboy": "^1.5.5",
    "@types/heic-convert": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/ramda": "^0.29.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.106.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
