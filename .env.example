# Process configuration. These values are immutable while the process is running.
APP_ENV=development
HTTP_PORT=7001
HTTP_HOSTNAME=0.0.0.0
STORAGE_PATH=./storage-dev
LOG_LEVEL=info

ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN_SECONDS=43200

CORS_ORIGINS=
API_BASE_PATH=/
PUBLIC_BASE_URL=http://localhost:7001
HTTP_BODY_HARD_LIMIT_BYTES=67108864
ALLOW_EMPTY_DATA=false

# Frontend build-time settings.
VITE_API_PREFIX=/
VITE_BASE_PATH=/
VITE_CACHE_WORKER_URL=
VITE_BUILD_DESCRIPTION=

# Runtime-adjustable settings live in <STORAGE_PATH>/instance-config.json.
# They are created with defaults on first start and can be changed through the
# adminGetInstanceConfig / adminUpdateInstanceConfig actions.
