# Process configuration. These values are immutable while the process is running.

APP_ENV=development
HTTP_PORT=7001
HTTP_HOST=0.0.0.0
STORAGE_PATH=./storage
LOG_LEVEL=info

ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN_SECONDS=43200

CORS_ORIGINS=http://localhost:3000
API_BASE_PATH=/
PUBLIC_BASE_URL=http://localhost:7001
HTTP_BODY_HARD_LIMIT_BYTES=67108864
# Set to true only when deliberately initializing an empty production storage.
ALLOW_EMPTY_DATA=false

# Runtime-adjustable settings live in <STORAGE_PATH>/instance-config.json.
# They are created with defaults on first start and can be changed through
# the adminGetInstanceConfig / adminUpdateInstanceConfig actions.
