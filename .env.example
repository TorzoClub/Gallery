# =============================================================================
# Torzo Gallery environment template
# =============================================================================
#
# 这个文件只是模板，不会被应用自动加载。复制后按环境填写：
#
#   cp .env.example .env.development   # pnpm dev
#   cp .env.example .env.production    # pnpm start / pnpm start:prod
#
# 实际的 .env.development / .env.production 已被 .gitignore 忽略。
# 不要提交真实密码、JWT secret、token、storage 数据或部署地址。
#
# 约定：
# - 进程配置在启动时读取，修改后必须重启服务进程。
# - VITE_* 是前端构建时变量，修改后需要重新构建前端。
# - VITE_* 会被打包进浏览器代码，禁止放任何秘密。
# - 同一个 storage 同一时间只允许一个进程写入，不要同时跑 dev/prod。
#
# 变量值不要加行内注释。`#` 注释请单独占一行。
# =============================================================================


# =============================================================================
# 运行环境
# =============================================================================

# development | test | production
# - development：本地开发，校验较宽松
# - test：测试环境
# - production：生产环境，必须显式配置 PUBLIC_BASE_URL，且 JWT_SECRET 至少 32 字符
#
# 如果这是 .env.production，请改成 production。
APP_ENV=development


# =============================================================================
# HTTP 服务
# =============================================================================

# 唯一的 HTTP 端口，范围 1–65535，默认 7001。
# development 和 production 都使用这个端口；不再启动独立的 Vite 端口。
# 页面、API、图片、WebSocket 和健康检查全部通过该端口访问。
HTTP_PORT=7001

# 服务端绑定地址，不是浏览器访问的域名，也不是 Host 校验。
# - 0.0.0.0   监听所有网卡
# - 127.0.0.1 只允许本机访问
# - 10.0.0.5  只绑定该网卡
#
# 浏览器不能访问 0.0.0.0，实际访问地址由 PUBLIC_BASE_URL 决定。
# HTTP_HOST 是旧的兼容别名，新配置请只使用 HTTP_HOSTNAME。
HTTP_HOSTNAME=0.0.0.0

# storage 根目录，必填。相对路径以进程工作目录为基准，最终会解析为绝对路径。
# 目录中包含 pool JSON、instance 配置和 source/optimized/thumb/temp 图片。
#
# development 建议使用独立的开发目录。
# production 必须使用持久化目录，并做好备份。
# 不要把 storage 放在临时目录、容器可丢弃层或 git 工作区。
STORAGE_PATH=./storage-dev

# 日志级别：debug | info | warn | error，默认 info。
LOG_LEVEL=info


# =============================================================================
# 后台认证
# =============================================================================

# Behind 页后台登录密码，必填，不能为空。
# 请替换为强密码；示例值 change-me 绝不能用于生产。
ADMIN_PASSWORD=change-me

# JWT HS256 签名密钥，必填。
# - production 至少 32 字符
# - 修改后所有已签发 token 立即失效，需要重新登录
# - 不要提交到仓库，不要复用其他系统的密钥
# - 可以用 `openssl rand -hex 32` 生成
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# JWT 有效期，单位秒，默认 43200（12 小时），最小 60。
JWT_EXPIRES_IN_SECONDS=43200


# =============================================================================
# CORS
# =============================================================================

# 逗号分隔的允许跨域 origin 列表。
# - development 留空：默认允许所有来源（*）
# - production 留空：不允许跨域；同源部署通常就应该留空
# - 如果前端和 API 不同源，填写精确 origin，例如：
#   https://gallery.example.com,https://admin.example.com
#
# 不要在生产环境随意使用 *，也不要包含路径或末尾斜杠。
CORS_ORIGINS=


# =============================================================================
# API 与公开地址
# =============================================================================

# 服务端 API 基础路径，默认 /。
# 规范化规则：自动补前导 /，删除末尾多余的 /。
#
# 当前单体 SPA 按根路径部署，必须保持 /；修改前确认服务端路由和前端 VITE_API_PREFIX
# 同步调整。
API_BASE_PATH=/

# 浏览器实际访问站点的 origin，用于生成图片和头像的绝对 URL。
# 必须包含协议、域名/IP 和端口；不要带路径、查询参数或末尾斜杠。
#
# 重要：
# - production 必须显式设置，缺少会启动失败
# - 它不控制服务端监听；监听地址是 HTTP_HOSTNAME
# - 远程访问必须填远程地址，否则图片 URL 会指向访问者自己的 localhost
# - 通过反向代理或 HTTPS 时，填外部地址
# - 修改后必须重启进程；不是清理浏览器缓存能解决的问题
#
# 示例：
#   本机开发：http://localhost:7001
#   局域网：  http://10.0.0.5:7001
#   生产域名：https://gallery.example.com
PUBLIC_BASE_URL=http://localhost:7001

# HTTP 请求体硬上限，单位字节，默认 67108864（64 MiB），最小 1024。
# instance 配置中的 max_upload_bytes 不能超过该值。
# 调大上限会增加内存和拒绝服务防护压力，按实际需求设置。
HTTP_BODY_HARD_LIMIT_BYTES=67108864

# 是否允许 production 服务使用空 storage 启动。
# - false：正常生产必须已有 storage
# - true：仅供首次初始化空生产 storage 时临时使用，初始化后应改回 false
#
# 不要长期设为 true；它不是“跳过 storage 检查”的开关。
ALLOW_EMPTY_DATA=false


# =============================================================================
# 前端构建时配置
# =============================================================================

# 以下变量在 pnpm build:client 时读取并打包进浏览器代码。
# 修改后需要重新构建；重启进程本身不会更新它们。
#
# 不要把密码、JWT secret、API token 等秘密放进 VITE_* 变量。

# 前端请求 API 的基础前缀，会保证末尾有 /。
# 当前同源根路径部署应保持 /，并与服务端 API_BASE_PATH 保持一致。
VITE_API_PREFIX=/

# 前端静态资源 base path，必须以 / 开头。
# 当前单体 SPA 要求按根路径部署，保持 /。
VITE_BASE_PATH=/

# 可选的公开展示图片缓存 worker URL。
# 仅在 production 构建中使用；development 不使用。
# 设置后图片 URL 会转换为：
#   <VITE_CACHE_WORKER_URL>?target=<编码后的图片URL>
# 留空表示直连本站 /images 路径。
VITE_CACHE_WORKER_URL=

# 公开页底部显示的构建说明文本，可选。
# 会原样展示在公开页构建信息区域；留空则不显示。
VITE_BUILD_DESCRIPTION=


# =============================================================================
# 运行期配置
# =============================================================================
#
# 以下配置不属于环境变量，保存在 <STORAGE_PATH>/instance-config.json：
#
#   avatar_thumb_size
#   image_thumb_size
#   image_thumb_quality
#   avif_source_quality
#   image_processing_effort
#   max_image_dimension
#   max_upload_bytes
#
# 首次启动会自动生成默认值，可在后台 /admin 的 AdminConsole 修改，
# 或调用 adminGetInstanceConfig / adminUpdateInstanceConfig。
#
# 这些设置只影响后续上传和显式重建，不会自动重做已有图片。
# 完整说明见 docs/configure.md。
